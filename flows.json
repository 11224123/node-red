    {
        "id": "f1f99efba6524947",
        "type": "function",
        "z": "c3c5a4d9666a4253",
        "name": "模擬燈光設備並回傳",
        "func": "let d;\ntry { d = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload; } catch(e) { node.warn(\"控制指令不是 JSON\"); return null; }\nconst allowed = [\"kitchen\",\"living_room\",\"bedroom\"];\nif (!d || !allowed.includes(d.device)) return null;\nconst brightness = Math.max(0, Math.min(100, Math.round(Number(d.brightness) || 0)));\nconst state = flow.get(\"lights\") || {};\nstate[d.device] = { device:d.device, brightness:brightness, on:brightness > 0 };\nflow.set(\"lights\", state);\nmsg.topic = \"AIOT/user2/status/led\";\nmsg.payload = JSON.stringify(state[d.device]);\nnode.status({fill: brightness > 0 ? \"green\":\"grey\",shape:\"dot\",text:d.device + \"：\" + brightness + \"%\"});\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
