    {
        "id": "1000000000000003",
        "type": "function",
        "z": "1000000000000001",
        "name": "產生三間教室感測資料",
        "func": "let rooms = [\"A\", \"B\", \"C\"];\nlet temperatures = [];\nlet humidities = [];\n\nrooms.forEach(room => {\n    temperatures.push({\n        room: room,\n        temperature: Number((23 + Math.random() * 7).toFixed(1))\n    });\n    humidities.push({\n        room: room,\n        humidity: Number((40 + Math.random() * 30).toFixed(1))\n    });\n});\n\nlet tempMsg = {\n    topic: \"AIOT/user1/sensor/temperature\",\n    payload: JSON.stringify(temperatures)\n};\n\nlet humidityMsg = {\n    topic: \"AIOT/user1/sensor/humidity\",\n    payload: JSON.stringify(humidities)\n};\n\nreturn [tempMsg, humidityMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 160,
        "wires": [
            [
                "1000000000000004"
            ],
            [
                "1000000000000005"
            ]
        ]
    },
