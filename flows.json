        "func": "let d;\ntry { d = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload; } catch(e) { return null; }\nif (!d || !d.device) return null;\nconst names = {kitchen:\"Kitchen\",living_room:\"Living Room\",bedroom:\"Bedroom\"};\nmsg.payload = (names[d.device] || d.device) + \"：\" + (d.on ? \"開啟\" : \"關閉\") + \"｜亮度 \" + d.brightness + \"%\";\nreturn msg;",
