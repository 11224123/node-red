    {
        "id": "2384052e03a8d9b3",
        "type": "function",
        "z": "983344dea33fda0f",
        "name": "解析訊息並轉純文字",
        "func": "// 接收任何文字或 JSON，轉成可以顯示的文字\nlet p = msg.payload;\nif (typeof p === 'string') {\n  const s = p.trim();\n  if (s.startsWith('{')) {\n    try { p = JSON.parse(s); } catch (e) { p = s; }\n  }\n}\nif (p !== null && typeof p === 'object') {\n  p = p.content ?? p.message ?? p.text ?? JSON.stringify(p);\n}\nconst content = String(p ?? '');\nconst kind = String(msg.topic || '').split('/').pop();\nconst names = {announcement:'公告',alert:'警報',status:'狀態'};\nconst label = names[kind] || '其他';\nconst history = flow.get('broadcast_history') || [];\nhistory.unshift('【' + label + '】' + content);\nif (history.length > 30) history.length = 30;\nflow.set('broadcast_history',history);\nconst totals=flow.get('broadcast_totals') || {announcement:0,alert:0,status:0};\ntotals[kind]=(totals[kind] || 0)+1;\nflow.set('broadcast_totals',totals);\nreturn [\n  {payload:history.join('\\n')},\n  {payload:'公告 '+totals.announcement+' 則｜警報 '+totals.alert+' 則｜狀態 '+totals.status+' 則'},\n  {topic:msg.topic,payload:content}\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
